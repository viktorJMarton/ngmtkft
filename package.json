{
  "name": "klima-villany-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/images.mjs",
    "prebuild": "node scripts/images.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check:seo": "node scripts/check-seo.mjs",
    "test:browser": "playwright test",
    "test:consent": "node scripts/check-consent.mjs",
    "check": "npm test && npm run build && npm run check:seo && npm run test:browser && npm run test:consent",
    "capture": "node scripts/capture.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "cheerio": "1.2.0",
    "daisyui": "^5.0.0",
    "fast-xml-parser": "5.11.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "yaml": "2.9.1"
  }
}
